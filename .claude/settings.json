{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/convex-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Vérification de la cible Convex"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/e2e-output-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Vérification de la lecture des résultats e2e"
          }
        ]
      }
    ]
  }
}
